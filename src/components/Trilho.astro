---
// Trilho horizontal de cartões, sobre uma faixa de cor com grão e borda de papel rasgado.
// Quem chama só renderiza se houver itens (trilho vazio não aparece).
import { Ilustra } from './marca/Ilustra.tsx';

interface Props {
  titulo: string;
  id: string;
  tom?: 'noite' | 'anil' | 'barro' | 'nanquim' | 'papel' | 'areia' | 'sol';
  arte?: string;
  verTudo?: { href: string; texto: string };
}
const { titulo, id, tom = 'noite', arte, verTudo } = Astro.props;
const claro = ['papel', 'areia', 'sol'].includes(tom);
---

<section
  aria-labelledby={`trilho-${id}`}
  class:list={['faixa grao rasgo relative overflow-hidden pb-8 pt-10', `faixa--${tom}`, claro && 'sobre-claro']}
  data-trilho={id}
>
  {arte && <Ilustra nome={arte} className="solta hidden rotate-12 md:right-[15rem] md:top-2 md:block md:w-24" />}
  <div class="relative mx-auto flex max-w-6xl items-end justify-between gap-4 px-4 pb-4 md:px-8">
    <h2 id={`trilho-${id}`} class="text-3xl md:text-5xl">{titulo}</h2>
    {
      verTudo && (
        <a href={verTudo.href} class="rotulo cor-destaque inline-flex min-h-11 items-center whitespace-nowrap">
          {verTudo.texto}
          <span class="so-leitor">: {titulo}</span>
        </a>
      )
    }
  </div>
  <div class="relative mx-auto max-w-6xl">
    <ul class="trilho" tabindex="0" aria-label={`${titulo}: role para o lado para ver mais`}>
      <slot />
    </ul>
  </div>
</section>
