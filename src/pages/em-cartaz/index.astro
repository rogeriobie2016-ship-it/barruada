---
import Cabecalho from '../../components/Cabecalho.astro';
import GradeCartaz from '../../islands/GradeCartaz.tsx';
import Base from '../../layouts/Base.astro';
import { itensEmCartaz } from '../../lib/cartaz.ts';
import { pautas, rota } from '../../lib/dados.ts';
import { lerTextos } from '../../lib/textos.ts';

// Só os dados do cartão vão para a ilha: o corpo do texto fica na página dele.
const textos = lerTextos().map(({ Content, ...resto }) => resto);
const itens = itensEmCartaz(pautas, textos);
---

<Base titulo="Em cartaz" descricao="Vídeos, carrosséis, podcast, blog e textos que o coletivo já publicou.">
  <Cabecalho
    tom="anil"
    arte="mic"
    rotulo="Em cartaz"
    titulo="O que já foi pro ar"
    texto="Vídeos, carrosséis, podcast, blog e textos do coletivo, cada um com link para o original."
  />
  {
    itens.length === 0 && (
      <div class="mx-auto max-w-6xl px-4 pt-8 md:px-8" data-vazio>
        <p class="caneta m-0 -rotate-1 text-4xl text-sol">A estreia tá no forno.</p>
        <p class="mt-3 max-w-xl text-lg">Nenhuma peça publicada ainda. Enquanto a primeira não sai, dá para jogar e fuçar a biblioteca.</p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href={rota('/jogos/')} class="botao botao-sol sobre-claro">Jogar</a>
          <a href={rota('/biblioteca/')} class="botao botao-linha">Abrir a biblioteca</a>
        </div>
      </div>
    )
  }
  <GradeCartaz itens={itens} base={rota('')} client:load />
</Base>
