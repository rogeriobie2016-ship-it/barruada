---
import Base from '../layouts/Base.astro';
import { rota } from '../lib/dados.ts';
---

<Base titulo="Página não encontrada">
  <div class="mx-auto max-w-3xl px-4 pt-16 md:px-8">
    <p class="rotulo m-0 text-sol">Erro 404</p>
    <h1 class="mt-3 text-6xl md:text-8xl">Deu uma barruada.</h1>
    <p class="mt-4 text-lg text-texto-suave">Essa página não existe, ou mudou de lugar.</p>
    <a href={rota('/')} class="botao botao-sol sobre-claro mt-6">Voltar para o início</a>
  </div>
</Base>
